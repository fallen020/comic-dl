        check) _arguments -C -s $_shtab_comic_dl_self_check_options ;;
        list) _arguments -C -s $_shtab_comic_dl_self_list_options ;;
        site) _shtab_comic_dl_self_site ;;
        update) _arguments -C -s $_shtab_comic_dl_self_update_options ;;
        version) _arguments -C -s $_shtab_comic_dl_self_version_options ;;
      esac
  esac
}

_shtab_comic_dl_self_site() {
  local context state line curcontext="$curcontext" one_or_more='(*)' remainder='(-)*:' default='*::: :->site'

  # Add default positional/remainder specs only if none exist, and only once per session
  if (( ! _shtab_comic_dl_self_site_defaults_added )); then
    if (( ${_shtab_comic_dl_self_site_options[(I)${(q)one_or_more}*]} +          ${_shtab_comic_dl_self_site_options[(I)${(q)remainder}*]} +          ${_shtab_comic_dl_self_site_options[(I)${(q)default}]} == 0 )); then
      _shtab_comic_dl_self_site_options+=(': :_shtab_comic_dl_self_site_commands' '*::: :->site')
    fi
    _shtab_comic_dl_self_site_defaults_added=1
  fi
  _arguments -C -s $_shtab_comic_dl_self_site_options

  case $state in
    site)
      words=($line[1] "${words[@]}")
      (( CURRENT += 1 ))
      curcontext="${curcontext%:*:*}:_shtab_comic_dl_self_site-$line[1]:"
      case $line[1] in
        check) _arguments -C -s $_shtab_comic_dl_self_site_check_options ;;
        list) _arguments -C -s $_shtab_comic_dl_self_site_list_options ;;
        update) _arguments -C -s $_shtab_comic_dl_self_site_update_options ;;
      esac
  esac
}



