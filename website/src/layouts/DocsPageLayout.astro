---
import BaseLayout from './BaseLayout.astro';
import DocsLayout from '../components/DocsLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { siteBase } from '../utils/base';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  entry: CollectionEntry<'docs'>;
  headings: Heading[];
}

const { entry, headings } = Astro.props;

const all = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((e) => e.id === entry.id);
const prev = idx > 0 ? all[idx - 1] : undefined;
const next = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : undefined;
const pageLink = (e?: CollectionEntry<'docs'>) =>
  e ? { id: e.id, title: e.data.title } : undefined;
const root = (Astro.site ?? Astro.url).toString().replace(/\/$/, '');
const crumbs = [
  { name: 'comic-dl', url: `${root}${siteBase}` },
  { name: 'Documentation', url: `${root}${siteBase}docs/` },
  { name: entry.data.title, url: `${root}${siteBase}docs/${entry.id}/` },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: entry.data.title,
  description: entry.data.description,
  mainEntityOfPage: crumbs[2].url,
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: c.url,
    })),
  },
};
---
<BaseLayout title={entry.data.title} description={entry.data.description} schema={schema}>
  <DocsLayout
    title={entry.data.title}
    description={entry.data.description}
    headings={headings}
    currentId={entry.id}
    prev={pageLink(prev)}
    next={pageLink(next)}
  >
    <slot />
  </DocsLayout>
</BaseLayout>