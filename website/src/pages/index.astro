---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { BookDown, Download, Rocket, Globe } from '@lucide/astro';
import BrandIcon from '../components/icons/BrandIcon.astro';
import { docsPath } from '../utils/base';
import { readFileSync } from 'node:fs';
const heroCommand = 'comic-dl -u "<gallery-or-series-url>"';
const pyproject = readFileSync(new URL('../../../../pyproject.toml', import.meta.url), 'utf-8');
const project = pyproject.slice(pyproject.indexOf('[project]'));
const appVersion = project.match(/^version\s*=\s*"([^"]+)"/m)?.[1] ?? '0.0.0';
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'comic-dl',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: ['Windows', 'Linux', 'macOS'],
  description:
    'A command-line downloader for comics and manga. Download from supported sites and package into CBZ, ZIP, or CBT archives.',
  url: 'https://fallen020.github.io/comic-dl/',
  license: 'https://github.com/fallen020/comic-dl/blob/main/LICENSE',
  offers: { '@type': 'Offer', price: '0' },
};
---
<BaseLayout
  title="comic-dl"
  description="A command-line downloader for comics and manga. Download from supported sites and package into CBZ, ZIP, or CBT archives."
  schema={softwareSchema}
>
  <Header />

  <main id="main-content" tabindex="-1" class="mx-auto flex w-full max-w-4xl flex-col items-center px-4 pb-24 pt-16 sm:px-6 sm:pt-24">
    <a
      href="https://github.com/fallen020/comic-dl/releases"
      target="_blank"
      rel="noopener noreferrer"
      class="mb-6 inline-flex items-center gap-2 rounded-full border border-line bg-surface-1 px-3 py-1 text-xs text-fg-secondary no-underline transition-colors hover:border-accent hover:text-fg"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-tip-border" aria-hidden="true"></span>
      v{appVersion} — early release, CLI options may change.
    </a>

    <h1 class="text-balance text-center text-4xl font-bold tracking-tight text-fg sm:text-5xl">
      A command-line downloader for comics and manga.
    </h1>
    <p class="mt-4 max-w-xl text-pretty text-center text-lg text-fg-secondary">
      comic-dl downloads galleries from supported sites, page by page, and packages them into CBZ,
      ZIP, or CBT archives — ready for your reader.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href={docsPath(`installation`)} data-astro-prefetch="hover"
        class="inline-flex items-center gap-2 rounded-md bg-accent px-4 py-2 text-sm font-semibold text-surface no-underline shadow-[var(--shadow-card)] transition-all hover:-translate-y-0.5 hover:opacity-90 active:translate-y-0 active:shadow-none"
      >
        <Download size={16} aria-hidden="true" />
        Install comic-dl
      </a>
      <a
        href={docsPath(`reference/cli`)} data-astro-prefetch="hover"
        class="inline-flex items-center gap-2 rounded-md border border-line bg-surface-1 px-4 py-2 text-sm font-medium text-fg no-underline shadow-[var(--shadow-card)] transition-all hover:-translate-y-0.5 hover:border-accent hover:text-accent active:translate-y-0 active:shadow-none"
      >
        <BookDown size={16} aria-hidden="true" />
        CLI Reference
      </a>
    </div>

    <div class="mt-12 w-full">
      <CodeBlock code={heroCommand} lang="bash" filename="terminal" />
      <p class="mt-3 text-sm text-fg-secondary">
        Replace <code>&lt;gallery-or-series-url&gt;</code> with a URL from a
        <a href={docsPath('reference/supported-sites')} data-astro-prefetch="hover">supported site</a>.
        Archives are saved in your Downloads folder under <code>comic-dl/</code> by default.
      </p>
    </div>

    <nav aria-label="Quick links" class="mt-10 grid w-full grid-cols-1 gap-3 sm:grid-cols-3">
      <a
        href={docsPath(`installation`)} data-astro-prefetch="hover"
        class="group rounded-lg border border-line bg-surface-1 p-4 no-underline shadow-[var(--shadow-card)] transition-all hover:-translate-y-0.5 hover:border-accent hover:bg-surface-2"
      >
        <Download size={18} class="text-accent" aria-hidden="true" />
        <p class="mt-2 text-sm font-medium text-fg">Install</p>
        <p class="mt-0.5 text-xs text-fg-secondary">Binaries or from source</p>
      </a>
      <a
        href={docsPath(`quick-start`)} data-astro-prefetch="hover"
        class="group rounded-lg border border-line bg-surface-1 p-4 no-underline shadow-[var(--shadow-card)] transition-all hover:-translate-y-0.5 hover:border-accent hover:bg-surface-2"
      >
        <Rocket size={18} class="text-accent" aria-hidden="true" />
        <p class="mt-2 text-sm font-medium text-fg">Quick Start</p>
        <p class="mt-0.5 text-xs text-fg-secondary">Download a gallery</p>
      </a>
      <a
        href={docsPath(`reference/supported-sites`)} data-astro-prefetch="hover"
        class="group rounded-lg border border-line bg-surface-1 p-4 no-underline shadow-[var(--shadow-card)] transition-all hover:-translate-y-0.5 hover:border-accent hover:bg-surface-2"
      >
        <Globe size={18} class="text-accent" aria-hidden="true" />
        <p class="mt-2 text-sm font-medium text-fg">Supported Sites</p>
        <p class="mt-0.5 text-xs text-fg-secondary">29 built-in scrapers</p>
      </a>
    </nav>
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto flex w-full max-w-4xl flex-col items-center justify-between gap-2 px-4 py-6 text-xs text-fg-muted sm:flex-row sm:px-6">
      <p>comic-dl is MIT-licensed.</p>
      <p class="flex items-center gap-4">
        <a href={docsPath(`introduction`)} data-astro-prefetch="hover" class="hover:text-fg">Docs</a>
        <a href="https://github.com/fallen020/comic-dl" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-fg">
          <BrandIcon name="github" size={14} /> Source
        </a>
      </p>
    </div>
  </footer>

  <script>
    import { enhanceCodeBlocks } from '../scripts/copy';
    enhanceCodeBlocks();
  </script>
</BaseLayout>