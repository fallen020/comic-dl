---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import { docsPath } from '../../utils/base';
import { docGroups } from '../../utils/doc-groups';

const entries = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const orderedGroups = docGroups(entries);
---
<BaseLayout
  title="Documentation"
  description="Guides, configuration, and reference for comic-dl."
>
  <Header />

  <main id="main-content" tabindex="-1" class="mx-auto w-full max-w-[var(--shell-max)] px-[var(--gutter)] pb-24 pt-12">
    <h1 class="text-3xl font-bold tracking-tight text-fg">Documentation</h1>
    <p class="mt-2 max-w-[var(--measure)] text-fg-secondary">
      Everything comic-dl can do, grouped by task. Start with
      <a href={docsPath('installation')} data-astro-prefetch="hover">Installation</a> or
      <a href={docsPath('quick-start')} data-astro-prefetch="hover">Quick Start</a>.
    </p>

    {orderedGroups.map((group) => (
      <section class="mt-10" aria-label={group.label || 'Guides'}>
        {group.label && (
          <h2 class="eyebrow">
            {group.label}
          </h2>
        )}
        <ul class="mt-3 grid grid-cols-1 gap-3 min-[26rem]:grid-cols-2 min-[60rem]:grid-cols-3">
          {group.items.map((entry) => (
            <li>
              <a
                href={docsPath(entry.id)} data-astro-prefetch="hover"
                class="card card-link h-full p-4"
              >
                <p class="text-sm font-medium text-fg">{entry.data.title}</p>
                {entry.data.description && (
                  <p class="mt-0.5 text-xs text-fg-secondary">{entry.data.description}</p>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>
</BaseLayout>
