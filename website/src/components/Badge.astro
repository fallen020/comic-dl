---
interface Props {
  status: 'supported' | 'partial' | 'broken' | 'untested';
}
const { status } = Astro.props;
const labels: Record<string, string> = {
  supported: 'Supported',
  partial: 'Partial',
  broken: 'Broken',
  untested: 'Untested',
};
---
<span class={`badge badge-${status}`}>{labels[status]}</span>