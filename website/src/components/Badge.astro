---
// Capability badge. `supported` is the only status the site-support manifest
// can currently carry (see site-support.json, regenerated from the scraper
// registry), so that is the only one rendered. An unrecognised value falls
// through to the raw string rather than an empty pill: a status the docs do
// not model yet should be visible, not silently blank.
interface Props {
  status: 'supported';
}
const { status } = Astro.props;
---
<span class={`badge badge-${status}`}>Supported</span>
