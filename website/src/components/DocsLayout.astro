---
import Header from './Header.astro';
import Sidebar from './Sidebar.astro';
import TableOfContents from './TableOfContents.astro';
import { ArrowLeft, ArrowRight } from '@lucide/astro';
import { docsPath } from '../utils/base';

interface PageLink {
  id: string;
  title: string;
}
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  title: string;
  description?: string;
  headings: Heading[];
  currentId: string;
  prev?: PageLink;
  next?: PageLink;
}

const { title, description, headings, currentId, prev, next } = Astro.props;
const docHref = (id: string) => docsPath(id);
---
<div class="flex min-h-screen flex-col">
  <Header showMenu />

  <div class="lg:mx-auto lg:w-full lg:max-w-[1440px] lg:grid lg:grid-cols-[260px_minmax(0,1fr)] lg:gap-8 xl:grid-cols-[260px_minmax(0,1fr)_220px]">
    <!-- Desktop sidebar -->
    <div class="hidden lg:block">
      <div class="sticky top-14 max-h-[calc(100vh-3.5rem)] overflow-y-auto py-8 lg:pl-4">
        <Sidebar currentId={currentId} />
      </div>
    </div>

    <!-- Mobile drawer -->
    <dialog
      id="docs-nav"
      data-sidebar-drawer
      class="fixed inset-y-0 left-0 m-0 h-dvh max-h-none w-72 max-w-full overflow-y-auto border-r border-line bg-surface px-4 py-4 text-fg shadow-2xl lg:hidden"
      aria-label="Documentation navigation"
    >
      <form method="dialog" class="mb-4 flex justify-end">
        <button autofocus class="rounded border border-line px-3 py-2 text-sm hover:bg-surface-2">Close navigation</button>
      </form>
      <Sidebar currentId={currentId} />
    </dialog>

    <!-- Content -->
    <main id="main-content" tabindex="-1" class="min-w-0 px-4 py-8 sm:px-8 lg:px-0 lg:py-10 xl:px-4">
      <article class="prose prose-docs" data-pagefind-body>
        <h1 class="!mt-0">{title}</h1>
        {description && <p class="not-prose -mt-2 mb-6 text-base text-fg-secondary">{description}</p>}
        {headings.some((h) => h.depth >= 2 && h.depth <= 3) && (
          <details class="not-prose mb-6 rounded border border-line p-3 xl:hidden">
            <summary class="cursor-pointer text-sm font-medium">On this page</summary>
            <div class="mt-3">
              <TableOfContents headings={headings} />
            </div>
          </details>
        )}
        <slot />
      </article>

      {(prev || next) && (
        <nav aria-label="Page navigation" class="mt-12 flex items-stretch justify-between gap-4 border-t border-line pt-6">
          {prev ? (
            <a href={docHref(prev.id)} data-astro-prefetch="hover" class="group min-w-0 basis-1/2 rounded-lg border border-line p-4 no-underline transition-colors hover:border-accent">
              <span class="flex items-center gap-1 text-xs uppercase tracking-wide text-fg-muted group-hover:text-accent">
                <ArrowLeft size={14} aria-hidden="true" /> Previous
              </span>
              <span class="mt-1 block truncate text-sm font-medium text-fg">{prev.title}</span>
            </a>
          ) : <span class="basis-1/2"></span>}
          {next ? (
            <a href={docHref(next.id)} data-astro-prefetch="hover" class="group min-w-0 basis-1/2 rounded-lg border border-line p-4 text-right no-underline transition-colors hover:border-accent">
              <span class="flex items-center justify-end gap-1 text-xs uppercase tracking-wide text-fg-muted group-hover:text-accent">
                Next <ArrowRight size={14} aria-hidden="true" />
              </span>
              <span class="mt-1 block truncate text-sm font-medium text-fg">{next.title}</span>
            </a>
          ) : <span class="basis-1/2"></span>}
        </nav>
      )}
    </main>

    <!-- TOC -->
    <div class="hidden xl:block">
      <div class="sticky top-14 max-h-[calc(100vh-3.5rem)] overflow-y-auto py-8 pl-2">
        <TableOfContents headings={headings} />
      </div>
    </div>
  </div>
</div>

<script is:inline>
(() => {
  const toggle = document.querySelector('[data-sidebar-toggle]');
  const drawer = document.querySelector('[data-sidebar-drawer]');
  if (!(toggle instanceof HTMLElement) || !(drawer instanceof HTMLDialogElement)) return;

  const desktop = window.matchMedia('(min-width: 64rem)');
  let previousOverflow = '';

  toggle.addEventListener('click', () => {
    if (desktop.matches || drawer.open) return;
    previousOverflow = document.body.style.overflow;
    drawer.showModal();
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  });
  drawer.addEventListener('close', () => {
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = previousOverflow;
    const target = desktop.matches ? document.getElementById('main-content') : toggle;
    target?.focus({ preventScroll: true });
  });
  drawer.addEventListener('click', (event) => {
    if (event.target !== drawer) return;
    const bounds = drawer.getBoundingClientRect();
    if (event.clientX < bounds.left || event.clientX > bounds.right ||
        event.clientY < bounds.top || event.clientY > bounds.bottom) drawer.close();
  });
  drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => drawer.close()));
  desktop.addEventListener('change', () => {
    if (desktop.matches && drawer.open) drawer.close();
  });
})();
</script>

<script>
  import { enhanceCodeBlocks } from '../scripts/copy';
  import { initScrollSpy } from '../scripts/scroll-spy';
  enhanceCodeBlocks();
  initScrollSpy();
  document.querySelectorAll<HTMLTableElement>('.prose-docs table').forEach((table) => {
    const region = document.createElement('div');
    region.className = 'docs-table-scroll';
    region.tabIndex = 0;
    region.setAttribute('role', 'region');
    region.setAttribute('aria-label', `${table.rows[0]?.textContent?.trim() || 'Reference'} table`);
    table.before(region);
    region.appendChild(table);
  });
</script>