---
import Header from './Header.astro';
import Sidebar from './Sidebar.astro';
import TableOfContents from './TableOfContents.astro';
import { ArrowLeft, ArrowRight, X } from '@lucide/astro';
import { docsPath } from '../utils/base';

interface PageLink {
  id: string;
  title: string;
}
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  title: string;
  description?: string;
  headings: Heading[];
  currentId: string;
  prev?: PageLink;
  next?: PageLink;
  section?: string;
  lastUpdated?: string;
}

const { title, description, headings, currentId, prev, next, section, lastUpdated } = Astro.props;
const docHref = (id: string) => docsPath(id);
---
<div class="flex min-h-dvh flex-col">
  <Header showMenu />

  <!-- Rails are fluid, the middle column takes the slack, and the whole shell
       stops growing at --shell-max: past that, more column width would only
       stretch the measure that the prose is already capped at. -->
  <div class="mx-auto grid w-full max-w-[var(--shell-max)] grid-cols-1 px-[var(--gutter)] lg:grid-cols-[var(--rail)_minmax(0,1fr)] lg:gap-x-8 2xl:gap-x-12 xl:grid-cols-[var(--rail)_minmax(0,1fr)_var(--toc-rail)]">
    <!-- Desktop sidebar -->
    <div class="hidden lg:block">
      <div
        data-scroll-host
        class="sticky top-[var(--header-h)] max-h-[calc(100dvh-var(--header-h))] overflow-y-auto py-8 pe-1"
      >
        <Sidebar currentId={currentId} />
      </div>
    </div>

    <!-- Mobile drawer -->
    <dialog
      id="docs-nav"
      data-sidebar-drawer
      data-scroll-host
      class="fixed inset-y-0 left-0 m-0 h-dvh max-h-none w-[min(18rem,85vw)] max-w-full overscroll-contain overflow-y-auto border-r border-line bg-surface px-4 py-4 text-fg shadow-[var(--shadow-pop)] lg:hidden"
      aria-label="Documentation navigation"
    >
      <div class="mb-4 flex justify-end">
        <button
          type="button"
          data-sidebar-close
          class="drawer-close inline-flex items-center gap-1.5 rounded border border-line bg-surface-1 px-2.5 py-1.5 text-sm text-fg-secondary transition-colors hover:border-accent hover:text-fg"
        >
          <X size={15} aria-hidden="true" />
          Close
        </button>
      </div>
      <Sidebar currentId={currentId} />
    </dialog>

    <!-- Content -->
    <main id="main-content" tabindex="-1" class="min-w-0 py-8 lg:py-10">
      <div class="not-prose mb-4 flex items-center justify-between gap-3 text-xs text-fg-muted">
        <nav aria-label="Breadcrumb">
          <ol class="flex flex-wrap items-center gap-1.5">
            <li><a href={docsPath('')} class="transition-colors hover:text-fg">Docs</a></li>
            {section && (
              <li class="flex items-center gap-1.5" aria-current="location">
                <span aria-hidden="true">/</span>
                <span>{section}</span>
              </li>
            )}
          </ol>
        </nav>
        <a
          href={`https://github.com/fallen020/comic-dl/edit/main/docs/${currentId}.md`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex shrink-0 items-center gap-1 transition-colors hover:text-fg"
          title="Help improve this page"
        >
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" /></svg>
          Edit this page
        </a>
      </div>
      <article class="prose prose-docs mx-auto max-w-[var(--content-max)]" data-pagefind-body>
        <h1 class="text-balance !mt-0">{title}</h1>
        {lastUpdated && (
          <p class="not-prose -mt-1 mb-2 text-xs text-fg-muted">
            Last updated <time datetime={lastUpdated}>{lastUpdated}</time>
          </p>
        )}
        {description && <p class="not-prose -mt-2 mb-6 max-w-[var(--measure)] text-base text-fg-secondary">{description}</p>}
        {headings.some((h) => h.depth >= 2 && h.depth <= 3) && (
          <details class="not-prose mb-6 rounded border border-line p-3 xl:hidden">
            <summary class="cursor-pointer text-sm font-medium">On this page</summary>
            <div class="mt-3">
              <TableOfContents headings={headings} />
            </div>
          </details>
        )}
        <slot />
      </article>

      {(prev || next) && (
        <nav aria-label="Page navigation" class="mx-auto mt-12 flex max-w-[var(--content-max)] flex-col items-stretch gap-3 border-t border-line pt-6 min-[26rem]:flex-row min-[26rem]:justify-between min-[26rem]:gap-4">
          {prev ? (
            <a href={docHref(prev.id)} data-astro-prefetch="hover" class="card card-link min-w-0 basis-1/2 p-4">
              <span class="card-kicker flex items-center gap-1">
                <ArrowLeft size={14} aria-hidden="true" /> Previous
              </span>
              <span class="mt-1 block text-sm font-medium text-fg min-[26rem]:truncate">{prev.title}</span>
            </a>
          ) : <span class="basis-1/2"></span>}
          {next ? (
            <a href={docHref(next.id)} data-astro-prefetch="hover" class="card card-link min-w-0 basis-1/2 p-4 min-[26rem]:text-right">
              <span class="card-kicker flex items-center gap-1 min-[26rem]:justify-end">
                Next <ArrowRight size={14} aria-hidden="true" />
              </span>
              <span class="mt-1 block text-sm font-medium text-fg min-[26rem]:truncate">{next.title}</span>
            </a>
          ) : <span class="basis-1/2"></span>}
        </nav>
      )}
    </main>

    <!-- TOC -->
    <div class="hidden xl:block">
      <div
        data-scroll-host
        class="sticky top-[var(--header-h)] max-h-[calc(100dvh-var(--header-h))] overflow-y-auto py-8 ps-1"
      >
        <TableOfContents headings={headings} />
      </div>
    </div>
  </div>
</div>

<script is:inline>
(() => {
  const toggle = document.querySelector('[data-sidebar-toggle]');
  const drawer = document.querySelector('[data-sidebar-drawer]');
  const closeButton = document.querySelector('[data-sidebar-close]');
  if (!(toggle instanceof HTMLElement) || !(drawer instanceof HTMLDialogElement)) return;

  const desktop = window.matchMedia('(min-width: 64rem)');
  let previousOverflow = '';

  toggle.addEventListener('click', () => {
    if (desktop.matches || drawer.open) return;
    previousOverflow = document.body.style.overflow;
    drawer.showModal();
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    // The drawer's own scroll starts at the top, which drops a reader deep in
    // the tree into an unrelated part of the nav with no sign of where they are.
    const current = drawer.querySelector('[aria-current="page"]');
    if (current instanceof HTMLElement) current.scrollIntoView({ block: 'center' });
  });
  closeButton?.addEventListener('click', () => drawer.close());
  drawer.addEventListener('close', () => {
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = previousOverflow;
    const target = desktop.matches ? document.getElementById('main-content') : toggle;
    target?.focus({ preventScroll: true });
  });
  drawer.addEventListener('click', (event) => {
    if (event.target !== drawer) return;
    const bounds = drawer.getBoundingClientRect();
    if (event.clientX < bounds.left || event.clientX > bounds.right ||
        event.clientY < bounds.top || event.clientY > bounds.bottom) drawer.close();
  });
  drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => drawer.close()));
  desktop.addEventListener('change', () => {
    if (desktop.matches && drawer.open) drawer.close();
  });
})();
</script>

<script is:inline>
(() => {
  const KEY = 'comic-dl:sidebar-scroll';
  // A sidebar click does a full page load; without this the sticky nav
  // resets to its top on every navigation. Remember where it was and put it
  // back, so a reader deep in the tree stays oriented.
  document.querySelectorAll('nav[aria-label="Documentation"] a').forEach((link) => {
    link.addEventListener('click', () => {
      const host = link.closest('[data-scroll-host]');
      if (!host) return;
      try { sessionStorage.setItem(KEY, String(host.scrollTop)); } catch {}
    });
  });
  const saved = (() => {
    try { return sessionStorage.getItem(KEY); } catch { return null; }
  })();
  if (saved) {
    document.querySelectorAll('[data-scroll-host]').forEach((host) => {
      host.scrollTop = Number(saved);
    });
  }
})();
</script>

<script>
  import { enhanceCodeBlocks } from '../scripts/copy';
  import { initScrollSpy } from '../scripts/scroll-spy';
  enhanceCodeBlocks();
  initScrollSpy();
  document.querySelectorAll<HTMLTableElement>('.prose-docs table').forEach((table) => {
    const region = document.createElement('div');
    region.className = 'docs-table-scroll';
    region.tabIndex = 0;
    region.setAttribute('role', 'region');
    region.setAttribute('aria-label', `${table.rows[0]?.textContent?.trim() || 'Reference'} table`);
    table.before(region);
    region.appendChild(table);
  });
</script>
