---
import { TriangleAlert } from '@lucide/astro';
interface Props { title?: string }
const { title } = Astro.props;
---
<div class="callout callout-warn" role="alert">
  <div class="callout-heading">
    <TriangleAlert size={16} class="callout-icon" aria-hidden="true" />
    {title && <span class="callout-title">{title}</span>}
    {!title && <span class="callout-title">Warning</span>}
  </div>
  <slot />
</div>