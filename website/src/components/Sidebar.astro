---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { docsPath } from '../utils/base';

interface Props {
  currentId: string;
}

type Doc = CollectionEntry<'docs'>;

const { currentId } = Astro.props;

const entries = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);

interface Group {
  label: string;
  order: number;
  items: Doc[];
}

const groups = new Map<string | null, Group>();
for (const entry of entries) {
  const label = entry.data.section ?? null;
  if (!groups.has(label)) {
    groups.set(label, { label: label ?? '', order: entry.data.order, items: [] });
  }
  const g = groups.get(label)!;
  g.items.push(entry);
  if (entry.data.order < g.order) g.order = entry.data.order;
}

const orderedGroups = Array.from(groups.values()).sort((a, b) => a.order - b.order);
---
<nav aria-label="Documentation" class="px-1">
  {orderedGroups.map((group) => (
    <details class="group mb-6" open>
      <summary class="mb-2 flex cursor-pointer list-none items-center justify-between rounded px-2 py-1 text-xs font-semibold uppercase tracking-wide text-fg-muted transition-colors hover:text-fg [&::-webkit-details-marker]:hidden">
        {group.label || 'Guides'}
        <svg
          class="h-3.5 w-3.5 shrink-0 text-fg-muted transition-transform duration-200 group-open:rotate-90"
          viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
        >
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </summary>
      <ul class="space-y-0.5">
        {group.items.map((entry) => {
          const active = entry.id === currentId;
          const href = docsPath(entry.id);
          return (
            <li>
              <a
                href={href}
                data-astro-prefetch="hover"
                aria-current={active ? 'page' : undefined}
                class={`block rounded px-2 py-1.5 text-sm no-underline transition-colors ${
                  active
                    ? 'bg-accent-dim/15 font-medium text-accent'
                    : 'text-fg-secondary hover:bg-surface-2 hover:text-fg'
                }`}
              >
                {entry.data.title}
              </a>
            </li>
          );
        })}
      </ul>
    </details>
  ))}
</nav>