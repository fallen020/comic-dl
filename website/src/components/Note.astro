---
import { Info } from '@lucide/astro';
interface Props { title?: string }
const { title } = Astro.props;
---
<div class="callout callout-note" role="note">
  <div class="callout-heading">
    <Info size={16} class="callout-icon" aria-hidden="true" />
    {title && <span class="callout-title">{title}</span>}
    {!title && <span class="callout-title">Note</span>}
  </div>
  <slot />
</div>