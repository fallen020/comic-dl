---
import { Lightbulb } from '@lucide/astro';
interface Props { title?: string }
const { title } = Astro.props;
---
<div class="callout callout-tip" role="note">
  <div class="callout-heading">
    <Lightbulb size={16} class="callout-icon" aria-hidden="true" />
    {title && <span class="callout-title">{title}</span>}
    {!title && <span class="callout-title">Tip</span>}
  </div>
  <slot />
</div>