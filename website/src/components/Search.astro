---
import { Search } from '@lucide/astro';
import { siteBase } from '../utils/base';
---
<div class="relative" data-search data-base={siteBase}>
  <button
    type="button"
    data-search-trigger
    class="inline-flex w-full items-center gap-2 rounded border border-line bg-surface-1 px-2.5 py-1.5 text-sm text-fg-secondary transition-colors hover:text-fg sm:w-48"
    aria-haspopup="dialog"
    aria-controls="search-modal"
  >
    <Search size={15} aria-hidden="true" />
    <span class="hidden sm:inline">Search</span>
    <span class="ml-auto hidden xl:inline">
      <kbd class="rounded border border-line bg-surface px-1 font-mono text-[0.65rem] text-fg-muted">Ctrl&nbsp;K</kbd>
    </span>
  </button>

  <div
    id="search-modal"
    class="fixed inset-0 z-50 hidden p-4 sm:p-6"
    data-search-modal
    role="dialog"
    aria-modal="true"
    aria-label="Search documentation"
  >
    <div class="absolute inset-0 bg-black/60" data-search-backdrop></div>
    <div class="relative mx-auto mt-[8vh] max-h-[80vh] w-full max-w-2xl overflow-y-auto rounded-lg border border-line bg-surface shadow-2xl">
      <div id="search-ui" class="p-4" data-search-ui>
        <p class="py-8 text-center text-sm text-fg-secondary" data-search-status>Loading search…</p>
      </div>
    </div>
  </div>
</div>
<script is:inline>
(() => {
  const root = document.currentScript?.closest('[data-search]');
  if (!root) return;
  const trigger = root.querySelector('[data-search-trigger]');
  const modal = root.querySelector('[data-search-modal]');
  const backdrop = root.querySelector('[data-search-backdrop]');
  const status = root.querySelector('[data-search-status]');
  const base = root.getAttribute('data-base') || '/';
  let ui = null;
  let initPromise = null;

  function close() {
    modal.classList.add('hidden');
    trigger.focus();
  }

  function open() {
    modal.classList.remove('hidden');
    ensureInit();
  }

  function loadCss(url) {
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = url;
    document.head.appendChild(link);
  }

  async function loadUi() {
    const url = `${base}pagefind/pagefind-ui.js`;
    if (globalThis.PagefindUI) return globalThis.PagefindUI;
    try {
      const mod = await import(/* @vite-ignore */ url);
      if (mod?.default) return mod.default;
    } catch { /* fall through to script injection */ }
    await new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = url;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error('load-failed'));
      document.head.appendChild(s);
    });
    if (globalThis.PagefindUI) return globalThis.PagefindUI;
    throw new Error('not-found');
  }

  function ensureInit() {
    if (!initPromise) {
      initPromise = (async () => {
        try {
          loadCss(`${base}pagefind/pagefind-ui.css`);
          const PagefindUI = await loadUi();
          if (!ui) {
            ui = new PagefindUI({
              element: '#search-ui',
              showSubResults: true,
              highlightParam: 'highlight',
              pageSize: 8,
              showImages: false,
              bundlePath: base,
            });
          }
          status?.remove();
          const input = root.querySelector('input.pagefind-ui__search-input');
          if (input) input.focus();
        } catch (e) {
          if (status) {
            status.textContent =
              'Search is not available yet. Run `npm run build:search` to generate the index.';
          }
        }
      })();
    }
  }

  trigger.addEventListener('click', () => {
    if (modal.classList.contains('hidden')) open();
    else close();
  });

  backdrop.addEventListener('click', close);

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (modal.classList.contains('hidden')) open();
      else close();
    }
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
      close();
    }
  });
})();
</script>