---
import { Search } from '@lucide/astro';
import { siteBase } from '../utils/base';
---
<div class="relative" data-search data-base={siteBase}>
  <button
    type="button"
    data-search-trigger
    class="inline-flex w-full items-center gap-2 rounded border border-line bg-surface-1 px-2.5 py-1.5 text-sm text-fg-secondary transition-colors hover:text-fg sm:w-48"
    aria-label="Search documentation"
    aria-haspopup="dialog"
    aria-controls="search-modal"
  >
    <Search size={15} aria-hidden="true" />
    <span class="hidden sm:inline">Search</span>
    <span class="ml-auto hidden xl:inline">
      <kbd class="rounded border border-line bg-surface px-1 font-mono text-[0.65rem] text-fg-muted">Ctrl&nbsp;K</kbd>
    </span>
  </button>

  <dialog
    id="search-modal"
    class="fixed inset-0 m-0 h-full max-h-none w-full max-w-none bg-transparent p-4 text-fg backdrop:bg-black/60 sm:p-6"
    data-search-modal
    aria-label="Search documentation"
  >
    <div class="relative mx-auto mt-[8vh] max-h-[80vh] w-full max-w-2xl overflow-y-auto rounded-lg border border-line bg-surface shadow-2xl">
      <div class="flex justify-end px-4 pt-4">
        <button type="button" data-search-close class="rounded border border-line bg-surface-1 px-3 py-1.5 text-sm text-fg-secondary hover:text-fg">Close search</button>
      </div>
      <div class="p-4">
        <p class="py-8 text-center text-sm text-fg-secondary" data-search-status role="status">Loading search…</p>
        <button type="button" data-search-retry hidden class="rounded border border-line bg-surface-1 px-3 py-1.5 text-sm text-fg-secondary hover:text-fg">Retry search</button>
        <div id="search-ui" data-search-ui></div>
      </div>
    </div>
  </dialog>
</div>
<script is:inline>
(() => {
  const root = document.currentScript?.previousElementSibling;
  if (!root?.matches('[data-search]')) return;
  const trigger = root.querySelector('[data-search-trigger]');
  const modal = root.querySelector('[data-search-modal]');
  const closeButton = root.querySelector('[data-search-close]');
  const retry = root.querySelector('[data-search-retry]');
  const status = root.querySelector('[data-search-status]');
  const base = root.getAttribute('data-base') || '/';
  let initPromise = null;
  let cssLoaded = false;

  function close() {
    modal.close();
  }

  async function open() {
    if (!modal.open) modal.showModal();
    await ensureInit();
    if (modal.open) root.querySelector('input.pagefind-ui__search-input')?.focus();
  }

  async function loadUi() {
    if (globalThis.PagefindUI) return globalThis.PagefindUI;
    await new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = `${base}pagefind/pagefind-ui.js`;
      script.onload = () => resolve();
      script.onerror = () => {
        script.remove();
        reject(new Error('load-failed'));
      };
      document.head.appendChild(script);
    });
    if (globalThis.PagefindUI) return globalThis.PagefindUI;
    throw new Error('not-found');
  }

  function ensureInit() {
    if (!initPromise) {
      status.hidden = false;
      status.textContent = 'Loading search…';
      retry.hidden = true;
      initPromise = (async () => {
        try {
          if (!cssLoaded) {
            const link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = `${base}pagefind/pagefind-ui.css`;
            document.head.appendChild(link);
            cssLoaded = true;
          }
          const PagefindUI = await loadUi();
          new PagefindUI({
            element: '#search-ui',
            showSubResults: true,
            highlightParam: 'highlight',
            pageSize: 8,
            showImages: false,
            bundlePath: `${base}pagefind/`,
          });
          status.hidden = true;
        } catch {
          status.textContent = 'Search could not load. Please check your connection and try again.';
          retry.hidden = false;
          initPromise = null;
        }
      })();
    }
    return initPromise;
  }

  trigger.addEventListener('click', open);
  closeButton.addEventListener('click', close);
  retry.addEventListener('click', open);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) close();
  });

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (modal.open) close();
      else open();
    }
  });
})();
</script>
