---
import { Menu, BookOpen } from '@lucide/astro';
import BrandIcon from './icons/BrandIcon.astro';
import Search from './Search.astro';
import ThemeToggle from './ThemeToggle.astro';
import { docsPath, siteBase } from '../utils/base';

interface Props {
  showMenu?: boolean;
}

const { showMenu = false } = Astro.props;
// The two destinations a reader reaches for most: the docs root and the list
// of sites the tool actually supports.
const nav = [
  { label: 'Docs', href: docsPath('') },
  { label: 'Supported Sites', href: docsPath('reference/supported-sites') },
];
---
<header class="sticky top-0 z-30 h-[var(--header-h)] border-b border-line bg-surface/80 backdrop-blur">
  <div class="mx-auto flex h-full max-w-[var(--shell-max)] items-center gap-2 px-[var(--gutter)]">
    {showMenu && (
      <button
        type="button"
        data-sidebar-toggle
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="docs-nav"
        class="-ml-1.5 inline-flex items-center rounded border border-line bg-surface-1 p-2 text-fg-secondary transition-colors hover:border-accent hover:text-fg lg:hidden"
      >
        <Menu size={18} aria-hidden="true" />
      </button>
    )}
    <a
      href={siteBase}
      class="flex items-center gap-2 font-mono text-lg font-semibold tracking-tight text-fg no-underline"
    >
      <BookOpen size={18} class="text-accent" aria-hidden="true" />
      <span>comic-dl</span>
    </a>
    <nav aria-label="Main" class="ml-1 hidden items-center gap-1 md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          data-astro-prefetch="hover"
          class="rounded px-2.5 py-1.5 text-sm text-fg-secondary no-underline transition-colors hover:bg-surface-1 hover:text-fg"
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-2">
      <Search />
      <a
        href="https://github.com/fallen020/comic-dl"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="comic-dl on GitHub"
        class="inline-flex items-center rounded border border-line bg-surface-1 p-1.5 text-fg-secondary transition-colors hover:border-accent hover:text-fg"
      >
        <BrandIcon name="github" size={16} />
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>
