---
interface Tab { label: string; value: string }
interface Props { tabs: Tab[]; label?: string }
const { tabs, label = 'Platform' } = Astro.props;
---
<div class="tabs" data-tabs>
  <div class="tabs-tablist" role="tablist" aria-label={label}>
    {tabs.map((t, i) => (
      <button
        type="button"
        role="tab"
        id={`tab-${t.value}`}
        aria-controls={`panel-${t.value}`}
        aria-selected={String(i === 0)}
        data-tab-button={t.value}
        class="tabs-tab"
        tabindex={i === 0 ? 0 : -1}
      >{t.label}</button>
    ))}
  </div>
  <div data-tab-panels>
    <slot />
  </div>
</div>
<script is:inline>
(() => {
  const root = document.currentScript?.closest('[data-tabs]');
  if (!root) return;
  const buttons = root.querySelectorAll('[data-tab-button]');
  const panels = root.querySelectorAll('[data-panel]');

  function activate(value) {
    buttons.forEach(btn => {
      const active = btn.getAttribute('data-tab-button') === value;
      btn.setAttribute('aria-selected', String(active));
      btn.setAttribute('tabindex', active ? '0' : '-1');
    });
    panels.forEach(panel => {
      panel.hidden = panel.getAttribute('data-panel') !== value;
    });
  }

  buttons.forEach(btn => {
    btn.addEventListener('click', () => activate(btn.getAttribute('data-tab-button')));
    btn.addEventListener('keydown', (e) => {
      const arr = Array.from(buttons);
      const idx = arr.indexOf(btn);
      let next = -1;
      if (e.key === 'ArrowRight') next = (idx + 1) % arr.length;
      if (e.key === 'ArrowLeft')  next = (idx - 1 + arr.length) % arr.length;
      if (next >= 0) {
        arr[next].focus();
        activate(arr[next].getAttribute('data-tab-button'));
        e.preventDefault();
      }
    });
  });

  if (panels.length) activate(panels[0].getAttribute('data-panel'));
})();
</script>