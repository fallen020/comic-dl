---
import { Terminal } from '@lucide/astro';
import BrandIcon from './icons/BrandIcon.astro';
interface Tab { label: string; value: string }
interface Props { tabs: Tab[]; label?: string }
const { tabs, label = 'Platform' } = Astro.props;
const brandFor: Record<string, 'windows' | 'debian' | 'fedora' | 'archlinux' | undefined> = {
  windows: 'windows',
  debian: 'debian',
  fedora: 'fedora',
  arch: 'archlinux',
};
---
<div class="tabs" data-tabs>
  <div class="tabs-tablist" role="tablist" aria-label={label}>
    {tabs.map((t, i) => (
      <button
        type="button"
        role="tab"
        id={`tab-${t.value}`}
        aria-controls={`panel-${t.value}`}
        aria-selected={String(i === 0)}
        data-tab-button={t.value}
        class="tabs-tab"
        tabindex={i === 0 ? 0 : -1}
      >{brandFor[t.value] ? <BrandIcon name={brandFor[t.value]!} size={14} /> : t.value === 'source' ? <Terminal size={14} aria-hidden="true" /> : null}{t.label}</button>
    ))}
  </div>
  <div data-tab-panels>
    <slot />
  </div>
</div>
<script is:inline>
(() => {
  const root = document.currentScript?.previousElementSibling;
  if (!root?.matches('[data-tabs]')) return;
  const buttons = root.querySelectorAll('[data-tab-button]');
  const panels = root.querySelectorAll('[data-panel]');

  function activate(value) {
    buttons.forEach(btn => {
      const active = btn.getAttribute('data-tab-button') === value;
      btn.setAttribute('aria-selected', String(active));
      btn.setAttribute('tabindex', active ? '0' : '-1');
    });
    panels.forEach(panel => {
      panel.hidden = panel.getAttribute('data-panel') !== value;
    });
  }

  buttons.forEach(btn => {
    btn.addEventListener('click', () => activate(btn.getAttribute('data-tab-button')));
    btn.addEventListener('keydown', (e) => {
      const arr = Array.from(buttons);
      const idx = arr.indexOf(btn);
      let next = -1;
      if (e.key === 'ArrowRight') next = (idx + 1) % arr.length;
      if (e.key === 'ArrowLeft')  next = (idx - 1 + arr.length) % arr.length;
      if (e.key === 'Home') next = 0;
      if (e.key === 'End') next = arr.length - 1;
      if (next >= 0) {
        arr[next].focus();
        activate(arr[next].getAttribute('data-tab-button'));
        e.preventDefault();
      }
    });
  });

  if (buttons.length) activate(buttons[0].getAttribute('data-tab-button'));
})();
</script>